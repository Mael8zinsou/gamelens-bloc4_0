# Copier en .env (ignore par git) et completer.

# --- PostgreSQL, couche Silver speed (temps reel) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=gamelens
POSTGRES_USER=gamelens_app
POSTGRES_PASSWORD=changeme

# --- Kafka (broker en mode KRaft, conteneur unique) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_PLAYERS=gamelens.steam.player_count

# --- Steam Web API ---
# GetNumberOfCurrentPlayers ne demande aucune cle d'API.
STEAM_POLL_INTERVAL_SECONDS=60

# --- Snowflake (a completer apres recreation du compte d'essai) ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=gamelens_wh
SNOWFLAKE_DATABASE=gamelens
SNOWFLAKE_SCHEMA=mart
