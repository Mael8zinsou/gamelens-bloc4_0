# Copier en .env (ignore par git) et completer.

# --- PostgreSQL, couche Silver speed (temps reel) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=gamelens
POSTGRES_USER=gamelens_app
POSTGRES_PASSWORD=changeme

# --- Kafka (broker en mode KRaft, conteneur unique) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_PLAYERS=gamelens.steam.player_count

# --- Canal de notification externe (V-02) ---
# Facultatif. Sans ces deux valeurs, la plateforme fonctionne a l'identique et
# la notification ne fait rien : absent n'est pas casse. En revanche un canal
# renseigne mais injoignable EST une panne, tracee en echec dans
# speed.pipeline_runs, ce qui declenche la regle critique echecs_composants.
#
# 1. Creer le bot en parlant a @BotFather dans Telegram : /newbot
# 2. Creer un canal, y ajouter le bot comme ADMINISTRATEUR
# 3. Publier un message dans le canal, puis relever son identifiant :
#      curl -s "https://api.telegram.org/bot<JETON>/getUpdates" \
#        | python -c "import json,sys; print(json.load(sys.stdin))"
#    L'identifiant d'un canal est NEGATIF, de la forme -100xxxxxxxxxx.
# 4. Verifier de bout en bout : python supervision/notifications.py --essai
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Fuseau d'AFFICHAGE des messages. La base stocke en UTC et continue de le
# faire : seule la mise en forme destinee a un lecteur est convertie.
GAMELENS_TIMEZONE=Europe/Paris

# --- Twitch Helix, popularite DIFFUSEE (seconde source) ---
# Facultatif, meme asymetrie que le canal de notification : sans ces deux
# valeurs la collecte d'audience est ignoree et le reste de la plateforme
# fonctionne a l'identique. Des identifiants presents mais refuses, en
# revanche, sont une panne tracee dans speed.pipeline_runs.
#
# 1. dev.twitch.tv/console/apps, Register Your Application
# 2. OAuth Redirect URL : http://localhost (le flux client_credentials ne
#    s'en sert pas, mais le formulaire l'exige)
# 3. Relever le Client ID, puis New Secret pour le Client Secret
# 4. Resoudre les identifiants de jeux : python ingestion/seed_twitch_ids.py
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
KAFKA_TOPIC_VIEWERS=gamelens.twitch.viewer_count

# --- Steam Web API ---
# GetNumberOfCurrentPlayers ne demande aucune cle d'API.
STEAM_POLL_INTERVAL_SECONDS=60

# --- Snowflake (a completer apres creation du compte d'essai) ---
# Identifiant de compte : forme ORGANISATION-COMPTE, lisible dans Snowsight sous
# Account details. Ce n'est ni l'URL complete, ni l'identifiant de region.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=GAMELENS_SERVICE
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=gamelens_wh
SNOWFLAKE_DATABASE=gamelens
SNOWFLAKE_SCHEMA=mart

# Authentification, deux modes exclusifs.
#
# 1. Paire de cles RSA, RECOMMANDE et souvent obligatoire : Snowflake impose
#    l'authentification multifacteur aux utilisateurs humains sur les comptes
#    recents, ce qu'un pipeline ne peut pas satisfaire.
#    Generer avec : python entrepot/generer_cle.py
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

#    Variante pour l'integration continue : SNOWFLAKE_PRIVATE_KEY recoit le
#    CONTENU PEM plutot qu'un chemin. Un dispositif de CI stocke des chaines,
#    pas des fichiers, et la cle n'a alors pas a etre ecrite sur le disque du
#    runner. A ne pas renseigner ici : ce secret vit dans le depot GitHub.
#      gh secret set SNOWFLAKE_PRIVATE_KEY < secrets/snowflake_key.p8

# 2. Mot de passe, pour la mise au point immediate uniquement.
SNOWFLAKE_PASSWORD=
