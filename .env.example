# Copier en .env (ignore par git) et completer.

# --- PostgreSQL, couche Silver speed (temps reel) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=gamelens
POSTGRES_USER=gamelens_app
POSTGRES_PASSWORD=changeme

# --- Kafka (broker en mode KRaft, conteneur unique) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_PLAYERS=gamelens.steam.player_count

# --- Steam Web API ---
# GetNumberOfCurrentPlayers ne demande aucune cle d'API.
STEAM_POLL_INTERVAL_SECONDS=60

# --- Snowflake (a completer apres creation du compte d'essai) ---
# Identifiant de compte : forme ORGANISATION-COMPTE, lisible dans Snowsight sous
# Account details. Ce n'est ni l'URL complete, ni l'identifiant de region.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=GAMELENS_SERVICE
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=gamelens_wh
SNOWFLAKE_DATABASE=gamelens
SNOWFLAKE_SCHEMA=mart

# Authentification, deux modes exclusifs.
#
# 1. Paire de cles RSA, RECOMMANDE et souvent obligatoire : Snowflake impose
#    l'authentification multifacteur aux utilisateurs humains sur les comptes
#    recents, ce qu'un pipeline ne peut pas satisfaire.
#    Generer avec : python entrepot/generer_cle.py
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

#    Variante pour l'integration continue : SNOWFLAKE_PRIVATE_KEY recoit le
#    CONTENU PEM plutot qu'un chemin. Un dispositif de CI stocke des chaines,
#    pas des fichiers, et la cle n'a alors pas a etre ecrite sur le disque du
#    runner. A ne pas renseigner ici : ce secret vit dans le depot GitHub.
#      gh secret set SNOWFLAKE_PRIVATE_KEY < secrets/snowflake_key.p8

# 2. Mot de passe, pour la mise au point immediate uniquement.
SNOWFLAKE_PASSWORD=
