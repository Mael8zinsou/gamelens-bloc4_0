{
  "uid": "gamelens-supervision",
  "title": "GameLens, supervision de la plateforme",
  "description": "Tableau de bord de supervision, livrable C4.3.1. Les indicateurs sont definis en SQL dans sql/schema_supervision.sql : Grafana les affiche, il ne les calcule pas.",
  "tags": [
    "gamelens",
    "supervision",
    "c4.3.1"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "editable": true,
  "panels": [
    {
      "id": 1,
      "title": "Etat de la plateforme",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "gamelens-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "gamelens-pg"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT element, valeur, unite, etat FROM speed.v_supervision_synthese",
          "refId": "A"
        }
      ],
      "description": "Un element surveille par ligne. Se lit sans connaitre les seuils : l'etat est calcule cote base, pas dans Grafana, pour rester le meme quel que soit le client qui interroge la plateforme.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "etat"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "nominal": {
                        "color": "green",
                        "index": 0,
                        "text": "nominal"
                      },
                      "avertissement": {
                        "color": "orange",
                        "index": 1,
                        "text": "avertissement"
                      },
                      "critique": {
                        "color": "red",
                        "index": 2,
                        "text": "critique"
                      },
                      "inconnu": {
                        "color": "text",
                        "index": 3,
                        "text": "inconnu"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 2,
      "title": "Alertes ouvertes",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "gamelens-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "gamelens-pg"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT severite, regle, message, declenchee_le FROM speed.alertes WHERE resolue_le IS NULL ORDER BY CASE severite WHEN 'critique' THEN 0 ELSE 1 END, declenchee_le",
          "refId": "A"
        }
      ],
      "description": "Alertes non resolues. Les alertes sont persistees et non seulement notifiees, ce qui permet de mesurer la duree d'un incident et pas seulement son occurrence."
    },
    {
      "id": 3,
      "title": "Fraicheur de la donnee",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "gamelens-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "gamelens-pg"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT flux, age_minutes FROM speed.v_indicateur_fraicheur",
          "refId": "A"
        }
      ],
      "description": "Age de la donnee la plus recente par flux. Repond a la seule question que se pose l'utilisateur d'un tableau de bord : de quand date ce que je vois ?",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^age_minutes$/",
          "values": true
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 45
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Completude de la collecte",
      "type": "gauge",
      "datasource": {
        "type": "postgres",
        "uid": "gamelens-pg"
      },
      "gridPos": {
        "x": 8,
        "y": 7,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "gamelens-pg"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT taux_completude_pct FROM speed.v_indicateur_completude",
          "refId": "A"
        }
      ],
      "description": "Titres distincts collectes sur 24h rapportes aux titres actifs. Detecte une source partiellement muette, qu'un simple comptage de lignes ne revele pas.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "green",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Latence du pipeline (p95)",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "gamelens-pg"
      },
      "gridPos": {
        "x": 16,
        "y": 7,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "gamelens-pg"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT latence_p95_s FROM speed.v_indicateur_latence",
          "refId": "A"
        }
      ],
      "description": "Temps ecoule entre la collecte et l'ecriture en base. Le p95 est prefere a la moyenne, qu'un seul pic suffit a rendre illisible.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 60
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Fiabilite des composants sur 24h",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "gamelens-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 14,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "gamelens-pg"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT composant, executions_24h, succes, echecs, inachevees, taux_succes_pct, duree_moyenne_s, derniere_execution FROM speed.v_indicateur_fiabilite ORDER BY composant",
          "refId": "A"
        }
      ],
      "description": "La colonne inachevees repere un composant interrompu avant sa fin : ni succes ni echec, cas qu'un simple taux de succes laisse invisible."
    },
    {
      "id": 7,
      "title": "Evenements collectes par heure",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "gamelens-pg"
      },
      "gridPos": {
        "x": 14,
        "y": 12,
        "w": 10,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "gamelens-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('hour', collected_at) AS time, count(*) AS evenements FROM speed.player_count_events WHERE $__timeFilter(collected_at) GROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ],
      "description": "Volume de collecte dans le temps. Un creux signale une interruption du producteur."
    }
  ]
}